# H2K TRAVEL — environment configuration example
# Copy to .env.local (never commit real values; never commit this filled in).
#
# RULE: only NEXT_PUBLIC_* values may reach the browser. Every other key
# below is server-only — used inside API routes / edge functions, never
# imported into a React component.

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_ENV=development          # development | production
H2K_TEST_MODE=true                       # true = sandbox providers + TEST MODE badge

# ── Database & auth (Supabase) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # SERVER ONLY — never expose

# ── Payments: Razorpay (India) ────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_key_id_here           # publishable, safe in browser
RAZORPAY_KEY_SECRET=your_secret_here                   # SERVER ONLY
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here       # SERVER ONLY

# ── Payments: Stripe (international) ──────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_publishable_key_here
STRIPE_SECRET_KEY=your_secret_here                     # SERVER ONLY
STRIPE_WEBHOOK_SECRET=your_webhook_secret_here         # SERVER ONLY

# ── Email (Resend) ────────────────────────────────────────────────────
RESEND_API_KEY=your_key_here                           # SERVER ONLY
EMAIL_FROM="H2K TRAVEL <bookings@your-domain.com>"
EMAIL_ADMIN=h2ktravel89@gmail.com

# ── Flight provider (Amadeus or Duffel) ───────────────────────────────
FLIGHT_PROVIDER=amadeus                                # amadeus | duffel
FLIGHT_API_KEY=your_key_here                           # SERVER ONLY
FLIGHT_API_SECRET=your_secret_here                     # SERVER ONLY
FLIGHT_API_BASE=https://test.api.amadeus.com           # sandbox host while testing

# ── Hotel provider (Amadeus or Hotelbeds) ─────────────────────────────
HOTEL_PROVIDER=amadeus                                 # amadeus | hotelbeds
HOTEL_API_KEY=your_key_here                            # SERVER ONLY
HOTEL_API_SECRET=your_secret_here                      # SERVER ONLY

# ── Optional: location autocomplete provider ──────────────────────────
LOCATION_PROVIDER=                                     # google-places | mapbox | geonames
LOCATION_API_KEY=                                      # SERVER ONLY (proxy through your API)

# ── SMS OTP (India-first: MSG91 or 2Factor) ─────────────────────────────
# Provider requires a registered sender ID and an approved DLT template.
SMS_PROVIDER=msg91          # msg91 | 2factor | twilio | textlocal | sns
SMS_API_KEY=
SMS_AUTH_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
SMS_OTP_EXPIRY_SECONDS=300
SMS_RESEND_COOLDOWN_SECONDS=30
SMS_MAX_ATTEMPTS=5
SMS_RATE_LIMIT_PER_10MIN=3
SMS_RATE_LIMIT_PER_HOUR=10
# development prints codes to the SERVER console only. NEVER in production.
OTP_PROVIDER_MODE=production
